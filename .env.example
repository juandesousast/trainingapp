# ==========================================
# TRINING APP - VARIABLES DE ENTORNO
# ==========================================

# Supabase (Configuración de la App)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ==========================================
# TOKENS PARA SERVIDORES MCP (AGENTES)
# ==========================================

# 1. Supabase MCP Server (@supabase/mcp-server-supabase)
# Generar en: Supabase Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. GitHub MCP Server (@modelcontextprotocol/server-github)
# Generar en: GitHub -> Settings -> Developer Settings -> Personal access tokens (Tokens classic / fine-grained con scope 'repo')
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Context7 MCP Server (Opcional, para cuota extendida)
# Generar en: https://context7.com
# CONTEXT7_API_KEY=ctx7_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
